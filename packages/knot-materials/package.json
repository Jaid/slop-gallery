{
  "name": "knot-materials",
  "version": "0.1.0",
  "type": "module",
  "description": "Procedural Three.js/TSL knot materials, metadata, placeholders and generation tools",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/slop-gallery.git",
    "directory": "packages/knot-materials"
  },
  "main": "src/main.ts",
  "exports": {
    ".": "./src/main.ts",
    "./scripts/*": "./scripts/*",
    "./*": "./src/*"
  },
  "scripts": {
    "make:prompt": "bun scripts/makePrompt.ts",
    "render:knot": "bun scripts/renderKnot.ts",
    "test": "bun test --max-concurrency 1 ./test",
    "update:announcements": "bun scripts/updateAnnouncements.ts"
  },
  "dependencies": {
    "math": "0.1.0",
    "three-async-materials": "workspace:*",
    "three-mesh-bvh": "0.9.16"
  },
  "peerDependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "fs-extra": "11.4.1",
    "puppeteer-core": "25.14.0",
    "three-fiber-game": "workspace:*",
    "typescript": "npm:typescript-classic@6.0.4",
    "vite": "8.3.4",
    "@types/fs-extra": "11.0.4",
    "@types/three": "0.186.0"
  },
  "files": [
    "src",
    "scripts",
    "readme.md",
    "license.txt"
  ],
  "sideEffects": false,
  "types": "./src/main.ts"
}
