{
  "name": "slop-gallery",
  "displayName": "Slop Gallery",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A living museum of happy accidents. A local-first WebGPU art gallery.",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/slop-gallery.git"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*",
    "#component/*": "./src/components/*/index.tsx",
    "#level/*": "./src/levels/gallery/*"
  },
  "scripts": {
    "build": "bun run vite build",
    "build:dev": "bun run vite build --mode development",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run check:package",
    "check:package": "bun scripts/checkPackage.ts",
    "dev": "bun run vite --mode development",
    "lint": "bun scripts/lint.ts",
    "preview": "bun run vite preview --host 127.0.0.1",
    "test": "bun test --max-concurrency 1 ./test",
    "test:live": "bun run build && bun test ./test/live.test.ts",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters --pretty false",
    "vite": "bun --bun node_modules/vite/dist/node/cli.js --configLoader native",
    "update:knots": "bun scripts/updateKnots.ts",
    "check:levels": "bun test/build/levels.ts",
    "build:gallery": "GAME_LEVEL=gallery bun run build --outDir dist/gallery",
    "dev:gallery": "GAME_LEVEL=gallery bun run dev",
    "build:knottingham": "GAME_LEVEL=knottingham bun run build --outDir dist/knottingham",
    "dev:knottingham": "GAME_LEVEL=knottingham bun run dev"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@react-three/drei": "11.0.0-alpha.7",
    "@react-three/fiber": "10.0.0-alpha.5",
    "@react-three/rapier": "2.2.0",
    "ai": "7.0.97",
    "clsx": "2.1.1",
    "compose-id": "0.2.0",
    "ego-player": "workspace:*",
    "es-toolkit": "1.52.0",
    "mount-root": "0.5.0",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "20.1.1",
    "telemethree": "workspace:*",
    "telemethree-ego": "workspace:*",
    "three": "0.186.0",
    "three-bvh-csg": "0.0.18",
    "three-fiber-game": "workspace:*",
    "three-mesh-bvh": "0.9.15",
    "use-graphics-quality": "workspace:*",
    "webgpu-capture-bridge": "workspace:*",
    "zustand": "5.0.15",
    "use-pause-menu": "workspace:*",
    "vite-plugin-game-level": "workspace:*",
    "vite-plugin-avif-only": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/bun": "1.4.2",
    "@types/postcss-normalize": "9.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.5.6",
    "babel-plugin-react-compiler": "1.0.0",
    "browserslist": "4.28.9",
    "caniuse-lite": "1.0.30001810",
    "cssnano-preset-advanced": "9.0.4",
    "eslint": "10.10.0",
    "eslint-config-jaid": "26.0.0",
    "fake-indexeddb": "6.2.5",
    "forward-slash-path": "0.3.0",
    "fs-extra": "11.4.0",
    "postcss": "8.5.28",
    "postcss-normalize": "13.0.1",
    "puppeteer-core": "25.10.0",
    "sass-embedded": "1.104.0",
    "terser": "5.51.2",
    "tsconfig-jaid-react": "16.0.0",
    "type-fest": "5.9.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "vite": "8.3.0",
    "vite-plugin-media-mixins": "0.10.0",
    "vite-plugin-title": "0.6.0"
  },
  "patchedDependencies": {
    "three-bvh-csg@0.0.18": "patches/three-bvh-csg@0.0.18.patch"
  },
  "workspaces": [
    "packages/*"
  ]
}
