{
  "name": "slop-gallery",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "A living museum of happy accidents. A local-first WebGPU art gallery.",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/slop-gallery.git"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*",
    "#component/*": "./src/components/*/index.tsx"
  },
  "scripts": {
    "build": "vite build",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run check:package",
    "check:package": "bun scripts/checkPackage.ts",
    "dev": "vite --host 127.0.0.1",
    "lint": "bun scripts/lint.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test ./test/unit ./packages/webgpu-capture-bridge/test ./packages/telemethree/test ./packages/telemethree-ego/test ./packages/use-graphics-quality/test ./packages/three-fiber-game/test ./packages/ego-player/test",
    "test:live": "bun run build && bun test ./test/live.test.ts",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters --pretty false"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@react-three/drei": "11.0.0-alpha.7",
    "@react-three/fiber": "10.0.0-alpha.5",
    "@react-three/rapier": "2.2.0",
    "ai": "7.0.97",
    "compose-id": "^0.2.0",
    "ego-player": "workspace:*",
    "es-toolkit": "1.52.0",
    "mount-root": "0.5.0",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "20.1.1",
    "telemethree": "workspace:*",
    "telemethree-ego": "workspace:*",
    "three": "0.186.0",
    "three-bvh-csg": "0.0.18",
    "three-fiber-game": "workspace:*",
    "three-mesh-bvh": "0.9.15",
    "use-graphics-quality": "workspace:*",
    "webgpu-capture-bridge": "workspace:*",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@dimforge/rapier3d": "0.20.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-config-jaid": "26.0.0",
    "fake-indexeddb": "6.2.5",
    "puppeteer-core": "25.10.0",
    "sass-embedded": "1.104.0",
    "tsconfig-jaid-bun": "16.0.0",
    "type-fest": "5.9.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "vite": "8.2.2"
  },
  "patchedDependencies": {
    "three-bvh-csg@0.0.18": "patches/three-bvh-csg@0.0.18.patch"
  },
  "workspaces": [
    "packages/*"
  ]
}
